<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Drifthound" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= javascript_tag nonce: true do %>
      (function () {
        var theme;
        try { theme = localStorage.getItem("drifthound-theme"); } catch (e) {}
        if (theme !== "light" && theme !== "dark") {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = theme;
      })();
    <% end %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="top-nav">
      <div class="nav-container">
        <div class="nav-left">
          <%= link_to root_path, class: "nav-brand" do %>
            <img src="/drifthound_logo.png" alt="DriftHound" class="nav-logo">
            <span>DriftHound</span>
          <% end %>
          <% if logged_in? && current_user.admin? %>
            <%= link_to users_path, class: "nav-link nav-link-left" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Users
            <% end %>
            <%= link_to api_tokens_path, class: "nav-link nav-link-left" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              API Tokens
            <% end %>
          <% end %>
        </div>
        <div class="nav-right">
          <button type="button" class="theme-toggle" data-controller="theme" data-action="click->theme#toggle" aria-label="Dark mode" aria-pressed="false" title="Switch to dark mode">
            <svg class="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            <svg class="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          </button>
          <% if logged_in? %>
            <span class="nav-user">
              <%= current_user.email %>
              <span class="role-badge role-badge--<%= current_user.role %> role-badge--sm"><%= current_user.role.humanize %></span>
            </span>
            <%= button_to "Logout", logout_path, method: :delete, class: "btn btn-secondary btn-sm" %>
          <% else %>
            <%= link_to "Login", login_path, class: "btn btn-secondary btn-sm" %>
          <% end %>
        </div>
      </div>
      <% if flash[:notice] || flash[:alert] %>
        <div class="flash-messages">
          <% if flash[:notice] %>
            <div class="flash flash-notice" data-controller="flash">
              <span><%= flash[:notice] %></span>
              <button type="button" class="flash-close" data-action="click->flash#dismiss">&times;</button>
            </div>
          <% end %>
          <% if flash[:alert] %>
            <div class="flash flash-alert" data-controller="flash">
              <span><%= flash[:alert] %></span>
              <button type="button" class="flash-close" data-action="click->flash#dismiss">&times;</button>
            </div>
          <% end %>
        </div>
      <% end %>
    </nav>

    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>
